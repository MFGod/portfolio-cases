      "css": ".ds-button-secondary{font-family:var(--font-body);font-size:var(--text-sm);font-weight:var(--weight-medium);min-height:var(--target);padding:var(--space-2) var(--space-4);border-radius:var(--radius);border:1px solid transparent;line-height:var(--leading-tight);cursor:pointer;transition:background-color var(--duration),border-color var(--duration);background:var(--color-surface);color:var(--color-ink);border-color:var(--color-outline);}.ds-button-secondary:hover:not(:disabled){background:var(--color-hover)}.ds-button-secondary:focus-visible{outline:2px solid var(--color-focus);outline-offset:3px;}.ds-button-secondary:disabled{opacity:.55;cursor:not-allowed}.ds-button-secondary:active:not(:disabled){background:var(--color-hover)}"
    },
