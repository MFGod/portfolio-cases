      "css": ".ds-field{display:block;font-family:var(--font-body);font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--color-ink)}.ds-field input{display:block;width:100%;box-sizing:border-box;margin-top:var(--space-2);min-height:calc(var(--target) + var(--space-1));padding:calc(var(--space-3) - 1px) var(--space-3);border:1px solid var(--color-outline);border-radius:var(--radius);background:var(--color-surface);color:var(--color-ink);font-family:var(--font-body);font-size:var(--text-md);font-weight:var(--weight-regular);line-height:var(--leading)}.ds-field input::placeholder{color:var(--color-placeholder);opacity:1}.ds-field input:focus-visible{outline:2px solid var(--color-focus);outline-offset:3px;}.ds-field input[aria-invalid=\"true\"]{border-color:var(--color-danger)}"
