      "html": "<nav class=\"ds-nav\" aria-label=\"Основная навигация\"><a href=\"#/wishlist\" aria-current=\"page\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20.8 4.6a5.5 5.5 0 0 0-7.8 0l-1 1-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z\"/></svg><span>Мои желания</span></a><a href=\"#/friends\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 20v-2a6 6 0 0 1 12 0v2M16 5a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 4v2\"/></svg><span>Друзья</span></a><a href=\"#/notifications\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4\"/></svg><span>Уведомления</span></a></nav>",
      "css": ".ds-nav{display:flex;justify-content:space-between;width:100%;height:calc(var(--mobile-nav-height) + var(--safe-bottom));padding:var(--space-1) var(--space-2) calc(var(--space-1) + var(--safe-bottom));background:var(--color-page);border-top:1px solid var(--color-line);font-family:var(--font-body)}.ds-nav a{display:inline-flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:var(--space-1);min-height:var(--target);font-size:var(--text-xs);line-height:var(--leading-tight);text-decoration:none;color:var(--color-muted);border-radius:var(--radius);white-space:nowrap}.ds-nav a[aria-current]{color:var(--color-accent);font-weight:var(--weight-strong)}.ds-nav a:hover{text-decoration:underline;text-underline-offset:var(--space-1)}.ds-nav a:focus-visible{outline:2px solid var(--color-focus);outline-offset:3px}@media(min-width:700px){.ds-nav{height:auto;padding:0;border-top:0;justify-content:flex-start;gap:var(--space-6)}.ds-nav a{flex:none;flex-direction:row;gap:var(--space-2);font-size:var(--text-sm);border-bottom:2px solid transparent;border-radius:0}.ds-nav a[aria-current]{border-bottom-color:var(--color-accent)}}"
    },
    {
      "name": "Собственная бронь",
