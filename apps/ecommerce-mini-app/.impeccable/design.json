      "html": "<nav class=\"ds-nav\" aria-label=\"Главное меню\"><a aria-current=\"page\" href=\"#catalog\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/></svg>Каталог</a><a href=\"#orders\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 3H18L20 7V20H4V7Z M4 7H20M9 11H15\"/></svg>Заказы</a><a class=\"ds-cart-shortcut\" href=\"#cart\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 3H5L8 16H19L22 7H6\"/><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"18\" cy=\"21\" r=\"1\"/></svg><span>Корзина<strong>425 ₽</strong></span></a></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:1fr 1fr 1.4fr;padding:var(--space-1) var(--space-2) var(--space-2);border-top:1px solid var(--border);background:var(--white);}.ds-nav a{font-family:var(--font-body);font-size:var(--text-md);line-height:var(--leading-body);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:var(--space-1);min-height:var(--nav-item);color:var(--muted);font-size:var(--text-sm);text-decoration:none;}.ds-nav a[aria-current]{color:var(--green);font-weight:var(--weight-bold);}.ds-nav svg{width:var(--icon);height:var(--icon);fill:none;stroke:currentColor;stroke-width:1.7;}.ds-nav a:hover{color:var(--ink);}.ds-nav a:focus-visible{outline:2px solid var(--focus);outline-offset:2px} .ds-nav a.ds-cart-shortcut{flex-direction:row;gap:var(--space-2);padding:var(--space-1) var(--space-2);border-radius:var(--radius-md);background:var(--green);color:var(--white);}.ds-cart-shortcut span{display:grid;gap:var(--space-1);}.ds-cart-shortcut strong{font-size:var(--text-sm);}.ds-nav a.ds-cart-shortcut[aria-current]{background:var(--green-dark);color:var(--white);}"
    },
